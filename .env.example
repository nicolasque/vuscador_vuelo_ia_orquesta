# =======================================================
# Vusca Vuelos Orquesta - Configuration
# =======================================================

# 1. Google Gemini API (Opcional - Si no se indica, se usan los agentes locales)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Kiwi.com / Tequila API (Recomendada: excelente para multidestino y stopovers)
# Registro gratuito en: https://tequila.kiwi.com/
KIWI_API_KEY=

# 3. RapidAPI - SkyScrapper / Skyscanner API
# Registro gratuito en: https://rapidapi.com/ (busca "flights-sky" o "Sky Scrapper")
RAPIDAPI_KEY=
RAPIDAPI_HOST=flights-sky.p.rapidapi.com

# 4. RapidAPI - Google Flights API (google-flights2)
# Registro gratuito en: https://rapidapi.com/ (busca "google-flights2")
GOOGLE_FLIGHTS_API_KEY=
GOOGLE_FLIGHTS_HOST=google-flights2.p.rapidapi.com

# 5. Duffel Flights API (Token gratuito de pruebas)
# Registro en: https://duffel.com/
DUFFEL_API_KEY=

# 6. Amadeus Self-Service (Opcional si dispones de acceso)
# Registro en: https://developers.amadeus.com/
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

# Modo de Proveedor:
# "auto" -> Detecta tus claves y si hay varias, activa MultiProviderPool automáticamente
# "pool" -> Fuerza el uso de múltiples APIs simultáneas para repartir carga y acelerar peticiones
# "mock" -> 100% offline sin necesidad de claves
FLIGHT_PROVIDER=auto

# Base de datos y Caché SQLite
CACHE_DB_PATH=vusca_cache.db
CACHE_TTL_HOURS=48

# Región de festivos por defecto
DEFAULT_COUNTRY=ES
DEFAULT_SUBDIV=MD
